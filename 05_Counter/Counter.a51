; ==============================================================================
; 專案名稱: AT89C52 9-Bit 二進位 LED 計數器 (連續加一 / 連續加二模式)
; 晶片型號: AT89C52 / AT89S52 (12MHz 晶體振盪器)
;
; 硬體接線定義:
;   - 控制按鈕 1 (連續加一 / 暫停): P1.0 (Pin 1) -> 按下接地 (低電位觸發)
;   - 控制按鈕 2 (連續加二 / 暫停): P1.1 (Pin 2) -> 按下接地 (低電位觸發)
;   - 9-Bit LED 輸出 (共陽極接法, 0 點亮, 1 熄滅):
;       Bit 0 (LSB) -> P2.0 (Pin 21) -> LED Bar Pin 1
;       Bit 1       -> P2.1 (Pin 22) -> LED Bar Pin 2
;       Bit 2       -> P2.2 (Pin 23) -> LED Bar Pin 3
;       Bit 3       -> P2.3 (Pin 24) -> LED Bar Pin 4
;       Bit 4       -> P2.4 (Pin 25) -> LED Bar Pin 5
;       Bit 5       -> P2.5 (Pin 26) -> LED Bar Pin 6
;       Bit 6       -> P2.6 (Pin 27) -> LED Bar Pin 7
;       Bit 7       -> P2.7 (Pin 28) -> LED Bar Pin 8
;       Bit 8 (MSB) -> P1.2 (Pin 3)  -> LED Bar Pin 9 (第 9 顆 LED)
;       (LED Bar 陽極 Pin 11~19 均連接至 +5V VCC)
;
; 動作邏輯:
;   - 開機初值: 0 (9 顆 LED 全滅, 二進位 000000000B)
;   - 按下按鈕 1 (P1.0): 啟動「連續加一」自動計數 (步長 = 1, 00 -> 01 -> 10 -> 11 ... -> 111111111 -> 0 循環)
;   - 按下按鈕 2 (P1.1): 啟動「連續加二」自動計數 (步長 = 2, 00 -> 10 -> 100 -> 110 ... 循環)
;   - 運行中再次按下當前模式的按鍵: 即時暫停 (維持當前 LED 數值，方便核對)
;   - 暫停時按下任一按鈕: 依該按鈕模式恢復連續跑動
; ==============================================================================

    ORG     0000H
    LJMP    MAIN

; ------------------------------------------------------------------------------
; 符號與腳位定義
; ------------------------------------------------------------------------------
KEY_RUN1    BIT     P1.0      ; 按鈕 1: 連續加一 / 暫停切換
KEY_RUN2    BIT     P1.1      ; 按鈕 2: 連續加二 / 暫停切換
LED_BIT8    BIT     P1.2      ; 第 9 顆 LED (Bit 8, 最高位 MSB, 0=亮, 1=滅)

; ------------------------------------------------------------------------------
; 變數定義 (內部 RAM 位址)
; ------------------------------------------------------------------------------
COUNT_L     DATA    30H       ; 計數器低 8 位 (Bit 0 ~ Bit 7, 範圍 00H ~ FFH)
STEP_VAL    DATA    31H       ; 本次累加步長 (01H = 加一, 02H = 加二)
FLAGS       DATA    20H       ; 狀態旗標組 (可位元定址區 20H~2FH)
RUN_FLAG    BIT     FLAGS.0   ; 自動運行旗標: 1 = 連續計數中, 0 = 暫停/待機
COUNT_B8    BIT     FLAGS.1   ; 計數器第 9 位 (Bit 8, 範圍 0 或 1)

; ------------------------------------------------------------------------------
; 主程式初始化
; ------------------------------------------------------------------------------
    ORG     0030H
MAIN:
    MOV     SP, #60H          ; 設定堆疊指標於內部 RAM 安全區域
    MOV     COUNT_L, #00H     ; 計數器低 8 位初值設為 0
    CLR     COUNT_B8          ; 計數器第 9 位初值設為 0
    CLR     RUN_FLAG          ; 初始為待機狀態 (等待按下按鈕啟動)
    MOV     STEP_VAL, #01H    ; 預設步長為 1

    ; 設定輸入腳位 (8051 準雙向口寫 1 開啟內部弱上拉)
    SETB    KEY_RUN1
    SETB    KEY_RUN2

    ; 初始更新顯示 (全滅: 000000000B)
    ACALL   UPDATE_LEDS

; ------------------------------------------------------------------------------
; 主迴圈: 依據運行狀態分別處理待機模式與自動計數模式
; ------------------------------------------------------------------------------
MAIN_LOOP:
    ; 檢查目前是否處於自動運行模式
    JB      RUN_FLAG, AUTO_RUN_PROCESS

; ------------------------------------------------------------------------------
; 待機 / 暫停模式處理: 監聽兩顆按鈕按下
; ------------------------------------------------------------------------------
PAUSE_MODE:
    ; 1. 檢測按鈕 1 是否按下 (觸發連續加一)
    JNB     KEY_RUN1, TRIG_BTN1
    ; 2. 檢測按鈕 2 是否按下 (觸發連續加二)
    JNB     KEY_RUN2, TRIG_BTN2
    SJMP    MAIN_LOOP

; --- 按鈕 1 觸發: 啟動連續加一 ---
TRIG_BTN1:
    ACALL   DELAY_20MS        ; 去彈跳延遲
    JB      KEY_RUN1, MAIN_LOOP ; 若為雜訊則忽略
WAIT_BTN1_RELEASE:
    JNB     KEY_RUN1, WAIT_BTN1_RELEASE ; 等待按鍵放開
    ACALL   DELAY_20MS        ; 放開去彈跳延遲
    MOV     STEP_VAL, #01H    ; 設定累加步長為 +1
    SETB    RUN_FLAG          ; 設為自動運行狀態
    SJMP    MAIN_LOOP

; --- 按鈕 2 觸發: 啟動連續加二 ---
TRIG_BTN2:
    ACALL   DELAY_20MS        ; 去彈跳延遲
    JB      KEY_RUN2, MAIN_LOOP ; 若為雜訊則忽略
WAIT_BTN2_RELEASE:
    JNB     KEY_RUN2, WAIT_BTN2_RELEASE ; 等待按鍵放開
    ACALL   DELAY_20MS        ; 放開去彈跳延遲
    MOV     STEP_VAL, #02H    ; 設定累加步長為 +2
    SETB    RUN_FLAG          ; 設為自動運行狀態
    SJMP    MAIN_LOOP

; ------------------------------------------------------------------------------
; 自動計數模式處理
; ------------------------------------------------------------------------------
AUTO_RUN_PROCESS:
    ; 1. 計數值累加 (依據 STEP_VAL 執行 +1 或 +2)
    ACALL   ADD_STEP

    ; 2. 刷新 9 顆 LED 顯示
    ACALL   UPDATE_LEDS

    ; 3. 步進延遲 (約 100ms)，並在延遲期間即時檢測按鍵 (暫停或模式切換)
    ACALL   DELAY_WITH_KEY_CHECK
    SJMP    MAIN_LOOP

; ------------------------------------------------------------------------------
; 子程式: 具備按鍵即時中斷偵測的步進延遲 (約 100ms)
; 設計說明:
;   將 100ms 拆解為 5 次 20ms 輪詢：
;   - 若按下正在執行的模式按鍵，則即時「暫停」計數。
;   - 若按下另一顆按鍵，則即時「無縫切換」步長（加一與加二互相切換）。
; ------------------------------------------------------------------------------
DELAY_WITH_KEY_CHECK:
    MOV     R4, #5            ; 5 * 20ms = 100ms 每步流暢速度
D_CHK_LOOP:
    ACALL   DELAY_20MS

    ; --- 檢查按鈕 1 (連續加一 / 暫停) ---
    JB      KEY_RUN1, CHK_BTN2_IN_RUN
    ACALL   DELAY_20MS
    JB      KEY_RUN1, CHK_BTN2_IN_RUN
    ; 判斷按鈕 1 行為
    MOV     A, STEP_VAL
    CJNE    A, #01H, SWITCH_TO_PLUS1 ; 若原本為加二，則切換為加一
    CLR     RUN_FLAG          ; 若原本就是加一，再次按下表示請求暫停
    SJMP    WAIT_KEY1_RELEASE
SWITCH_TO_PLUS1:
    MOV     STEP_VAL, #01H    ; 切換為連續加一
WAIT_KEY1_RELEASE:
    JNB     KEY_RUN1, WAIT_KEY1_RELEASE
    ACALL   DELAY_20MS
    RET                       ; 立即返回更新

    ; --- 檢查按鈕 2 (連續加二 / 暫停) ---
CHK_BTN2_IN_RUN:
    JB      KEY_RUN2, D_CHK_NEXT
    ACALL   DELAY_20MS
    JB      KEY_RUN2, D_CHK_NEXT
    ; 判斷按鈕 2 行為
    MOV     A, STEP_VAL
    CJNE    A, #02H, SWITCH_TO_PLUS2 ; 若原本為加一，則切換為加二
    CLR     RUN_FLAG          ; 若原本就是加二，再次按下表示請求暫停
    SJMP    WAIT_KEY2_RELEASE
SWITCH_TO_PLUS2:
    MOV     STEP_VAL, #02H    ; 切換為連續加二
WAIT_KEY2_RELEASE:
    JNB     KEY_RUN2, WAIT_KEY2_RELEASE
    ACALL   DELAY_20MS
    RET                       ; 立即返回更新

D_CHK_NEXT:
    DJNZ    R4, D_CHK_LOOP
    RET

; ------------------------------------------------------------------------------
; 子程式: 9-Bit 二進位計數器步進累加
; 運算邏輯:
;   (COUNT_B8 : COUNT_L) = (COUNT_B8 : COUNT_L) + STEP_VAL
;   - 先將 COUNT_L 加上 STEP_VAL (1 或 2)。
;   - 若低 8 位產生進位 (CY = 1)，則翻轉第 9 位元 (COUNT_B8)。
;   - 當 COUNT_B8 由 1 翻轉回 0 時，即達成 512 溢位歸零循環。
; ------------------------------------------------------------------------------
ADD_STEP:
    MOV     A, COUNT_L
    ADD     A, STEP_VAL       ; 低 8 位加上步長
    MOV     COUNT_L, A
    JNC     ADD_STEP_DONE     ; 若無進位，結束
    CPL     COUNT_B8          ; 若溢位產生進位，翻轉第 9 位元 (Bit 8)
ADD_STEP_DONE:
    RET

; ------------------------------------------------------------------------------
; 子程式: 更新 9 顆 LED 顯示 (共陽極 Active-Low 接法)
; 邏輯說明:
;   - 硬體為共陽極：腳位輸出 0 點亮，輸出 1 熄滅。
;   - 二進位表示：數值 1 代表點亮，數值 0 代表熄滅。
;   - 因此將計數值取反碼 (CPL) 後輸出至對應埠。
; ------------------------------------------------------------------------------
UPDATE_LEDS:
    ; 1. 輸出低 8 位 (Bit 0 ~ Bit 7) 至 P2.0 ~ P2.7
    MOV     A, COUNT_L
    CPL     A                 ; 取反碼: 1 轉為 0 (亮), 0 轉為 1 (滅)
    MOV     P2, A

    ; 2. 輸出第 9 位 (Bit 8, MSB) 至 P1.2 (LED_BIT8)
    MOV     C, COUNT_B8
    CPL     C                 ; 取反: 1 轉為 0 (亮), 0 轉為 1 (滅)
    MOV     LED_BIT8, C
    RET

; ------------------------------------------------------------------------------
; 軟體延遲子程式 (適用於 12MHz 晶振，1 個機器週期 = 1us)
; ------------------------------------------------------------------------------
DELAY_20MS:
    MOV     R6, #40
D20_L1:
    MOV     R7, #250
    DJNZ    R7, $             ; 250 * 2us = 500us
    DJNZ    R6, D20_L1        ; 40 * 500us = 20ms
    RET

    END