 Line  I  Addr  Code            Source

  152:	  009E	E5 31		    MOV     A, STEP_VAL
  153:	  00A0	B4 02 04	    CJNE    A, #02H, SWITCH_TO_PLUS2 ; 若原本為加一，則切換為加二
  154:	  00A3	C2 00		    CLR     RUN_FLAG          ; 若原本就是加二，再次按下表示請求暫停
  155:	  00A5	80 03		    SJMP    WAIT_KEY2_RELEASE
  156:	  00A7			SWITCH_TO_PLUS2:
  157:	  00A7	75 31 02	    MOV     STEP_VAL, #02H    ; 切換為連續加二
  158:	  00AA			WAIT_KEY2_RELEASE:
  159:	  00AA	30 91 FD	    JNB     KEY_RUN2, WAIT_KEY2_RELEASE
  160:	  00AD	11 C9		    ACALL   DELAY_20MS
  161:	  00AF	22		    RET                       ; 立即返回更新
  162:
  163:	  00B0			D_CHK_NEXT:
  164:	  00B0	DC C8		    DJNZ    R4, D_CHK_LOOP
  165:	  00B2	22		    RET
  166:
  167:				; ------------------------------------------------------------------------------
  168:				; 子程式: 9-Bit 二進位計數器步進累加
  169:				; 運算邏輯:
  170:				;   (COUNT_B8 : COUNT_L) = (COUNT_B8 : COUNT_L) + STEP_VAL
  171:				;   - 先將 COUNT_L 加上 STEP_VAL (1 或 2)。
  172:				;   - 若低 8 位產生進位 (CY = 1)，則翻轉第 9 位元 (COUNT_B8)。
  173:				;   - 當 COUNT_B8 由 1 翻轉回 0 時，即達成 512 溢位歸零循環。
  174:				; ------------------------------------------------------------------------------
  175:	  00B3			ADD_STEP:
  176:	  00B3	E5 30		    MOV     A, COUNT_L
  177:	  00B5	25 31		    ADD     A, STEP_VAL       ; 低 8 位加上步長
  178:	  00B7	F5 30		    MOV     COUNT_L, A
  179:	  00B9	50 02		    JNC     ADD_STEP_DONE     ; 若無進位，結束
  180:	  00BB	B2 01		    CPL     COUNT_B8          ; 若溢位產生進位，翻轉第 9 位元 (Bit 8)
  181:	  00BD			ADD_STEP_DONE:
  182:	  00BD	22		    RET
  183:
  184:				; ------------------------------------------------------------------------------
  185:				; 子程式: 更新 9 顆 LED 顯示 (共陽極 Active-Low 接法)
  186:				; 邏輯說明:
  187:				;   - 硬體為共陽極：腳位輸出 0 點亮，輸出 1 熄滅。
  188:				;   - 二進位表示：數值 1 代表點亮，數值 0 代表熄滅。
  189:				;   - 因此將計數值取反碼 (CPL) 後輸出至對應埠。
  190:				; ------------------------------------------------------------------------------
  191:	  00BE			UPDATE_LEDS:
  192:				    ; 1. 輸出低 8 位 (Bit 0 ~ Bit 7) 至 P2.0 ~ P2.7
  193:	  00BE	E5 30		    MOV     A, COUNT_L
  194:	  00C0	F4		    CPL     A                 ; 取反碼: 1 轉為 0 (亮), 0 轉為 1 (滅)
  195:	  00C1	F5 A0		    MOV     P2, A
  196:
  197:				    ; 2. 輸出第 9 位 (Bit 8, MSB) 至 P1.2 (LED_BIT8)
  198:	  00C3	A2 01		    MOV     C, COUNT_B8
  199:	  00C5	B3		    CPL     C                 ; 取反: 1 轉為 0 (亮), 0 轉為 1 (滅)
  200:	  00C6	92 92		    MOV     LED_BIT8, C
  201:	  00C8	22		    RET
  202:
  203:				; ------------------------------------------------------------------------------
  204:				; 軟體延遲子程式 (適用於 12MHz 晶振，1 個機器週期 = 1us)
  205:				; ------------------------------------------------------------------------------
  206:	  00C9			DELAY_20MS:
  207:	  00C9	7E 28		    MOV     R6, #40

ASEM-51 V1.3                                         Copyright (c) 2002 by W.W. Heinz                                         PAGE 5



 Line  I  Addr  Code            Source

  208:	  00CB			D20_L1:
  209:	  00CB	7F FA		    MOV     R7, #250
  210:	  00CD	DF FE		    DJNZ    R7, $             ; 250 * 2us = 500us
  211:	  00CF	DE FA		    DJNZ    R6, D20_L1        ; 40 * 500us = 20ms
  212:	  00D1	22		    RET
  213:
  214:				    END





