 Line  I  Addr  Code            Source

    1:				; ==============================================================================
    2:				; 專案名稱: AT89C52 9-Bit 二進位 LED 計數器 (連續加一 / 連續加二模式)
    3:				; 晶片型號: AT89C52 / AT89S52 (12MHz 晶體振盪器)
    4:				;
    5:				; 硬體接線定義:
    6:				;   - 控制按鈕 1 (連續加一 / 暫停): P1.0 (Pin 1) -> 按下接地 (低電位觸發)
    7:				;   - 控制按鈕 2 (連續加二 / 暫停): P1.1 (Pin 2) -> 按下接地 (低電位觸發)
    8:				;   - 9-Bit LED 輸出 (共陽極接法, 0 點亮, 1 熄滅):
    9:				;       Bit 0 (LSB) -> P2.0 (Pin 21) -> LED Bar Pin 1
   10:				;       Bit 1       -> P2.1 (Pin 22) -> LED Bar Pin 2
   11:				;       Bit 2       -> P2.2 (Pin 23) -> LED Bar Pin 3
   12:				;       Bit 3       -> P2.3 (Pin 24) -> LED Bar Pin 4
   13:				;       Bit 4       -> P2.4 (Pin 25) -> LED Bar Pin 5
   14:				;       Bit 5       -> P2.5 (Pin 26) -> LED Bar Pin 6
   15:				;       Bit 6       -> P2.6 (Pin 27) -> LED Bar Pin 7
   16:				;       Bit 7       -> P2.7 (Pin 28) -> LED Bar Pin 8
   17:				;       Bit 8 (MSB) -> P1.2 (Pin 3)  -> LED Bar Pin 9 (第 9 顆 LED)
   18:				;       (LED Bar 陽極 Pin 11~19 均連接至 +5V VCC)
   19:				;
   20:				; 動作邏輯:
   21:				;   - 開機初值: 0 (9 顆 LED 全滅, 二進位 000000000B)
   22:				;   - 按下按鈕 1 (P1.0): 啟動「連續加一」自動計數 (步長 = 1, 00 -> 01 -> 10 -> 11
				... -> 111111111 -> 0 循環)
   23:				;   - 按下按鈕 2 (P1.1): 啟動「連續加二」自動計數 (步長 = 2, 00 -> 10 -> 100 -> 11
				0 ... 循環)
   24:				;   - 運行中再次按下當前模式的按鍵: 即時暫停 (維持當前 LED 數值，方便核�
				��)
   25:				;   - 暫停時按下任一按鈕: 依該按鈕模式恢復連續跑動
   26:				; ==============================================================================
   27:
   28:		N      0000	    ORG     0000H
   29:	  0000	02 00 30	    LJMP    MAIN
   30:
   31:				; ------------------------------------------------------------------------------
   32:				; 符號與腳位定義
   33:				; ------------------------------------------------------------------------------
   34:		B	 90	KEY_RUN1    BIT     P1.0      ; 按鈕 1: 連續加一 / 暫停切換
   35:		B	 91	KEY_RUN2    BIT     P1.1      ; 按鈕 2: 連續加二 / 暫停切換
   36:		B	 92	LED_BIT8    BIT     P1.2      ; 第 9 顆 LED (Bit 8, 最高位 MSB, 0=亮, 1=滅)
   37:
   38:				; ------------------------------------------------------------------------------
   39:				; 變數定義 (內部 RAM 位址)
   40:				; ------------------------------------------------------------------------------

ASEM-51 V1.3                                         Copyright (c) 2002 by W.W. Heinz                                         PAGE 2



 Line  I  Addr  Code            Source

   41:		N	 30	COUNT_L     DATA    30H       ; 計數器低 8 位 (Bit 0 ~ Bit 7, 範圍 00H ~ FFH)
   42:		N	 31	STEP_VAL    DATA    31H       ; 本次累加步長 (01H = 加一, 02H = 加二)
   43:		N	 20	FLAGS       DATA    20H       ; 狀態旗標組 (可位元定址區 20H~2FH)
   44:		B	 00	RUN_FLAG    BIT     FLAGS.0   ; 自動運行旗標: 1 = 連續計數中, 0 = 暫停/待機
   45:		B	 01	COUNT_B8    BIT     FLAGS.1   ; 計數器第 9 位 (Bit 8, 範圍 0 或 1)
   46:
   47:				; ------------------------------------------------------------------------------
   48:				; 主程式初始化
   49:				; ------------------------------------------------------------------------------
   50:		N      0030	    ORG     0030H
   51:	  0030			MAIN:
   52:	  0030	75 81 60	    MOV     SP, #60H          ; 設定堆疊指標於內部 RAM 安全區域
   53:	  0033	75 30 00	    MOV     COUNT_L, #00H     ; 計數器低 8 位初值設為 0
   54:	  0036	C2 01		    CLR     COUNT_B8          ; 計數器第 9 位初值設為 0
   55:	  0038	C2 00		    CLR     RUN_FLAG          ; 初始為待機狀態 (等待按下按鈕啟動)
   56:	  003A	75 31 01	    MOV     STEP_VAL, #01H    ; 預設步長為 1
   57:
   58:				    ; 設定輸入腳位 (8051 準雙向口寫 1 開啟內部弱上拉)
   59:	  003D	D2 90		    SETB    KEY_RUN1
   60:	  003F	D2 91		    SETB    KEY_RUN2
   61:
   62:				    ; 初始更新顯示 (全滅: 000000000B)
   63:	  0041	11 BE		    ACALL   UPDATE_LEDS
   64:
   65:				; ------------------------------------------------------------------------------
   66:				; 主迴圈: 依據運行狀態分別處理待機模式與自動計數模式
   67:				; ------------------------------------------------------------------------------
   68:	  0043			MAIN_LOOP:
   69:				    ; 檢查目前是否處於自動運行模式
   70:	  0043	20 00 2A	    JB      RUN_FLAG, AUTO_RUN_PROCESS
   71:
   72:				; ------------------------------------------------------------------------------
   73:				; 待機 / 暫停模式處理: 監聽兩顆按鈕按下
   74:				; ------------------------------------------------------------------------------
   75:	  0046			PAUSE_MODE:
   76:				    ; 1. 檢測按鈕 1 是否按下 (觸發連續加一)
   77:	  0046	30 90 05	    JNB     KEY_RUN1, TRIG_BTN1
   78:				    ; 2. 檢測按鈕 2 是否按下 (觸發連續加二)
   79:	  0049	30 91 13	    JNB     KEY_RUN2, TRIG_BTN2
   80:	  004C	80 F5		    SJMP    MAIN_LOOP
   81:
   82:				; --- 按鈕 1 觸發: 啟動連續加一 ---
   83:	  004E			TRIG_BTN1:
   84:	  004E	11 C9		    ACALL   DELAY_20MS        ; 去彈跳延遲
   85:	  0050	20 90 F0	    JB      KEY_RUN1, MAIN_LOOP ; 若為雜訊則忽略
   86:	  0053			WAIT_BTN1_RELEASE:
   87:	  0053	30 90 FD	    JNB     KEY_RUN1, WAIT_BTN1_RELEASE ; 等待按鍵放開
   88:	  0056	11 C9		    ACALL   DELAY_20MS        ; 放開去彈跳延遲
   89:	  0058	75 31 01	    MOV     STEP_VAL, #01H    ; 設定累加步長為 +1
   90:	  005B	D2 00		    SETB    RUN_FLAG          ; 設為自動運行狀態
   91:	  005D	80 E4		    SJMP    MAIN_LOOP
   92:
   93:				; --- 按鈕 2 觸發: 啟動連續加二 ---
   94:	  005F			TRIG_BTN2:
   95:	  005F	11 C9		    ACALL   DELAY_20MS        ; 去彈跳延遲
   96:	  0061	20 91 DF	    JB      KEY_RUN2, MAIN_LOOP ; 若為雜訊則忽略

