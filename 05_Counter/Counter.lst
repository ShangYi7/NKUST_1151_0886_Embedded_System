 Line  I  Addr  Code            Source

   97:	  0064			WAIT_BTN2_RELEASE:
   98:	  0064	30 91 FD	    JNB     KEY_RUN2, WAIT_BTN2_RELEASE ; 等待按鍵放開
   99:	  0067	11 C9		    ACALL   DELAY_20MS        ; 放開去彈跳延遲
  100:	  0069	75 31 02	    MOV     STEP_VAL, #02H    ; 設定累加步長為 +2
  101:	  006C	D2 00		    SETB    RUN_FLAG          ; 設為自動運行狀態
  102:	  006E	80 D3		    SJMP    MAIN_LOOP
  103:
  104:				; ------------------------------------------------------------------------------
  105:				; 自動計數模式處理
  106:				; ------------------------------------------------------------------------------
  107:	  0070			AUTO_RUN_PROCESS:
  108:				    ; 1. 計數值累加 (依據 STEP_VAL 執行 +1 或 +2)
  109:	  0070	11 B3		    ACALL   ADD_STEP
  110:
  111:				    ; 2. 刷新 9 顆 LED 顯示
  112:	  0072	11 BE		    ACALL   UPDATE_LEDS
  113:
  114:				    ; 3. 步進延遲 (約 100ms)，並在延遲期間即時檢測按鍵 (暫停或模式切換)
  115:	  0074	11 78		    ACALL   DELAY_WITH_KEY_CHECK
  116:	  0076	80 CB		    SJMP    MAIN_LOOP
  117:
  118:				; ------------------------------------------------------------------------------
  119:				; 子程式: 具備按鍵即時中斷偵測的步進延遲 (約 100ms)
  120:				; 設計說明:
  121:				;   將 100ms 拆解為 5 次 20ms 輪詢：
  122:				;   - 若按下正在執行的模式按鍵，則即時「暫停」計數。
  123:				;   - 若按下另一顆按鍵，則即時「無縫切換」步長（加一與加二互相切換）�
				��
  124:				; ------------------------------------------------------------------------------
  125:	  0078			DELAY_WITH_KEY_CHECK:
  126:	  0078	7C 05		    MOV     R4, #5            ; 5 * 20ms = 100ms 每步流暢速度
  127:	  007A			D_CHK_LOOP:
  128:	  007A	11 C9		    ACALL   DELAY_20MS
  129:
  130:				    ; --- 檢查按鈕 1 (連續加一 / 暫停) ---
  131:	  007C	20 90 17	    JB      KEY_RUN1, CHK_BTN2_IN_RUN
  132:	  007F	11 C9		    ACALL   DELAY_20MS
  133:	  0081	20 90 12	    JB      KEY_RUN1, CHK_BTN2_IN_RUN
  134:				    ; 判斷按鈕 1 行為
  135:	  0084	E5 31		    MOV     A, STEP_VAL
  136:	  0086	B4 01 04	    CJNE    A, #01H, SWITCH_TO_PLUS1 ; 若原本為加二，則切換為加一
  137:	  0089	C2 00		    CLR     RUN_FLAG          ; 若原本就是加一，再次按下表示請求暫停
  138:	  008B	80 03		    SJMP    WAIT_KEY1_RELEASE
  139:	  008D			SWITCH_TO_PLUS1:
  140:	  008D	75 31 01	    MOV     STEP_VAL, #01H    ; 切換為連續加一
  141:	  0090			WAIT_KEY1_RELEASE:
  142:	  0090	30 90 FD	    JNB     KEY_RUN1, WAIT_KEY1_RELEASE
  143:	  0093	11 C9		    ACALL   DELAY_20MS
  144:	  0095	22		    RET                       ; 立即返回更新
  145:
  146:				    ; --- 檢查按鈕 2 (連續加二 / 暫停) ---
  147:	  0096			CHK_BTN2_IN_RUN:
  148:	  0096	20 91 17	    JB      KEY_RUN2, D_CHK_NEXT
  149:	  0099	11 C9		    ACALL   DELAY_20MS
  150:	  009B	20 91 12	    JB      KEY_RUN2, D_CHK_NEXT
  151:				    ; 判斷按鈕 2 行為

