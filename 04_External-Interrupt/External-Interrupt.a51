; ==============================================================================
; 專案名稱: AT89S52 外部中斷 (INT0) 穩定雙態暫停/重啟 (防卡死版)
; 核心改進:
;   1. 中斷內不放延遲、不原地等待放手，確保即刻 RETI 解除硬體中斷鎖定。
;   2. 手動清除 IE0 旗標，杜絕彈跳造成的二次誤觸。
;   3. 主迴圈負責處理暫停原地打轉與重啟時的放開去彈跳。
; ==============================================================================

    ORG     0000H
    LJMP    MAIN

    ORG     0003H             ; INT0 固定中斷向量位址
    LJMP    EXT0_ISR

; ------------------------------------------------------------------------------
; 變數定義
; ------------------------------------------------------------------------------
FLAG_REG    DATA    20H
PAUSE_FLAG  BIT     FLAG_REG.0        ; 0 = 正常流動, 1 = 暫停

; ------------------------------------------------------------------------------
; 主程式初始化
; ------------------------------------------------------------------------------
    ORG     0030H
MAIN:
    MOV     SP, #60H
    CLR     PAUSE_FLAG        ; 預設非暫停

    ; 確保 P3.2 處於輸入準備狀態 (寫 1 打開弱上拉)
    SETB    P3.2

    ; INT0 中斷暫存器設定
    SETB    IT0               ; IT0 = 1: 負邊緣觸發
    CLR     IE0               ; 先清空可能存在的歷史中斷旗標
    SETB    EX0               ; 致能 INT0
    SETB    EA                ; 致能全域中斷

    MOV     A, #0FEH          ; 初始流水燈 (P2.0 亮)

; ------------------------------------------------------------------------------
; 主迴圈
; ------------------------------------------------------------------------------
MAIN_LOOP:
    ; 1. 輸出目前 LED 狀態到 P2
    MOV     P2, A

    ; 2. 延遲約 200ms
    ACALL   DELAY_200MS

    ; 3. 移位
    RL      A

    ; 4. 暫停檢查區
CHECK_PAUSE:
    JNB     PAUSE_FLAG, MAIN_LOOP ; 若沒暫停，繼續流水燈

    ; ---- 若進入暫停 (PAUSE_FLAG = 1)，主迴圈在此等待 ----
WAIT_UNPAUSE:
    ; 在此空轉，等待下一次按鍵觸發中斷將 PAUSE_FLAG 翻轉為 0
    JB      PAUSE_FLAG, WAIT_UNPAUSE

    ; 剛解凍重啟時，防彈跳與等待按鍵放開 (在主迴圈做，絕不卡中斷!)
    ACALL   DELAY_20MS
WAIT_KEY_RELEASE:
    JNB     P3.2, WAIT_KEY_RELEASE
    ACALL   DELAY_20MS

    SJMP    MAIN_LOOP

; ------------------------------------------------------------------------------
; 極簡外部中斷常式 (ISR) - 幾微秒內完成並退出
; ------------------------------------------------------------------------------
EXT0_ISR:
    ; 1. 翻轉暫停狀態
    CPL     PAUSE_FLAG

    ; 2. 手動清除硬體外部中斷旗標 (消弭機械彈跳餘波)
    CLR     IE0

    ; 3. 立即返回，解除 8051 內部中斷優先權閉鎖
    RETI

; ------------------------------------------------------------------------------
; 延遲子程式 (12MHz 晶振)
; ------------------------------------------------------------------------------
DELAY_200MS:
    MOV     R6, #2
D200_1:
    MOV     R7, #200
D200_2:
    MOV     R5, #250
    DJNZ    R5, $
    DJNZ    R7, D200_2
    DJNZ    R6, D200_1
    RET

DELAY_20MS:
    MOV     R6, #40
D20_1:
    MOV     R7, #250
    DJNZ    R7, $
    DJNZ    R6, D20_1
    RET

    END