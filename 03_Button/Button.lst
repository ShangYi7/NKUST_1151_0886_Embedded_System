	Source File:	Button.a51
	Object File:	Button.hex
	List File:	Button.lst



 Line  I  Addr  Code            Source

    1:				; ==============================================================================
    2:				; 專案名稱: AT89S52 按鍵多功能控制 8-LED 疊加與長按連發 (P2 輸出)
    3:				; 腳位定義:
    4:				;   - 按鈕: P3.2 (低電位按下)
    5:				;   - LED:  P2.0 ~ P2.7 (低電位點亮, 0 = 亮, 1 = 滅)
    6:				; 邏輯說明:
    7:				;   - BASE_COUNT: 目前恆亮的燈數 (0 ~ 7)
    8:				;   - CURR_COUNT: 當前顯示的總亮燈數 (BASE_COUNT ~ 8)
    9:				;   - 短按: 亮燈數 +1
   10:				;   - 長按 (超過約 0.6 秒): 每 200ms 自動連發 +1
   11:				; ==============================================================================
   12:
   13:		N      0000	    ORG     0000H
   14:	  0000	02 00 30	    LJMP    MAIN
   15:
   16:				; ------------------------------------------------------------------------------
   17:				; 變數定義 (內部 RAM 位址)
   18:				; ------------------------------------------------------------------------------
   19:		N	 30	BASE_COUNT  DATA    30H       ; 恆亮基底燈數 (0 ~ 7)
   20:		N	 31	CURR_COUNT  DATA    31H       ; 目前亮燈總數 (0 ~ 8)
   21:		N	 32	HOLD_TIMER  DATA    32H       ; 長按累積計時器
   22:
   23:		B	 B2	KEY_PIN     BIT     P3.2      ; 按鍵腳位
   24:
   25:				; ------------------------------------------------------------------------------
   26:				; 主程式初始化
   27:				; ------------------------------------------------------------------------------
   28:		N      0030	    ORG     0030H
   29:	  0030			MAIN:
   30:	  0030	75 81 60	    MOV     SP, #60H          ; 設定堆疊指標
   31:	  0033	75 30 00	    MOV     BASE_COUNT, #00H  ; 初始基底: 0 顆恆亮
   32:	  0036	75 31 00	    MOV     CURR_COUNT, #00H  ; 初始總亮燈: 0 顆
   33:	  0039	11 7A		    ACALL   UPDATE_LEDS       ; 刷新 LED (P2 全部熄滅)
   34:
   35:				; ------------------------------------------------------------------------------
   36:				; 主迴圈: 輪詢按鍵
   37:				; ------------------------------------------------------------------------------
   38:	  003B			MAIN_LOOP:
   39:	  003B	20 B2 FD	    JB      KEY_PIN, MAIN_LOOP ; 若沒按下 (高電位 1), 繼續等待
   40:
   41:				    ; 1. 檢測到按下, 執行去彈跳
   42:	  003E	11 83		    ACALL   DELAY_20MS
   43:	  0040	20 B2 F8	    JB      KEY_PIN, MAIN_LOOP ; 若是彈跳雜訊, 忽略

ASEM-51 V1.3                                         Copyright (c) 2002 by W.W. Heinz                                         PAGE 2



 Line  I  Addr  Code            Source

   44:
   45:				    ; 2. 確定短按觸發: 立即增加一顆 LED
   46:	  0043	11 61		    ACALL   INC_LED_STEP
   47:	  0045	11 7A		    ACALL   UPDATE_LEDS
   48:
   49:				    ; 3. 進入長按判定階段 (延遲約 0.6 秒)
   50:	  0047	75 32 1E	    MOV     HOLD_TIMER, #30    ; 30 * 20ms = 600ms
   51:	  004A			WAIT_HOLD:
   52:	  004A	11 83		    ACALL   DELAY_20MS
   53:	  004C	20 B2 EC	    JB      KEY_PIN, MAIN_LOOP ; 若在 600ms 內放開, 視為單純短按, 回主迴圈
   54:	  004F	D5 32 F8	    DJNZ    HOLD_TIMER, WAIT_HOLD
   55:
   56:				    ; 4. 長按連發迴圈 (Auto-repeat): 只要沒放開, 每 200ms 增加一顆
   57:	  0052			AUTO_REPEAT_LOOP:
   58:	  0052	11 61		    ACALL   INC_LED_STEP
   59:	  0054	11 7A		    ACALL   UPDATE_LEDS
   60:
   61:				    ; 延遲 200ms (切分成 10 次 20ms, 隨時監控放開)
   62:	  0056	7D 0A		    MOV     R5, #10
   63:	  0058			REPEAT_DELAY:
   64:	  0058	11 83		    ACALL   DELAY_20MS
   65:	  005A	20 B2 DE	    JB      KEY_PIN, MAIN_LOOP ; 若途中放開按鈕, 立即退出連發
   66:	  005D	DD F9		    DJNZ    R5, REPEAT_DELAY
   67:
   68:	  005F	80 F1		    SJMP    AUTO_REPEAT_LOOP
   69:
   70:				; ------------------------------------------------------------------------------
   71:				; 子程式: 增加一顆 LED 並處理「進位 / 恆亮底數」邏輯
   72:				; ------------------------------------------------------------------------------
   73:	  0061			INC_LED_STEP:
   74:	  0061	05 31		    INC     CURR_COUNT
   75:	  0063	E5 31		    MOV     A, CURR_COUNT
   76:	  0065	B4 09 11	    CJNE    A, #9, INC_DONE    ; 若總數還沒達到 9 (0~8), 正常結束
   77:
   78:				    ; 當 8 個燈滿了之後, 下一次觸發進位:
   79:	  0068	05 30		    INC     BASE_COUNT
   80:	  006A	E5 30		    MOV     A, BASE_COUNT
   81:	  006C	B4 08 07	    CJNE    A, #8, SET_NEW_BASE
   82:
   83:				    ; 若 8 個燈都變成恆亮, 全部輪空重置 (回第 1 輪)
   84:	  006F	75 30 00	    MOV     BASE_COUNT, #00H
   85:	  0072	75 31 00	    MOV     CURR_COUNT, #00H
   86:	  0075	22		    RET
   87:
   88:	  0076			SET_NEW_BASE:
   89:				    ; 下一輪開始: 新的總亮燈數直接從新的基底開始
   90:	  0076	85 30 31	    MOV     CURR_COUNT, BASE_COUNT
   91:
   92:	  0079			INC_DONE:
   93:	  0079	22		    RET
   94:
   95:				; ------------------------------------------------------------------------------
   96:				; 子程式: 依 CURR_COUNT 更新 P2 輸出 (低電位點亮)
   97:				; ------------------------------------------------------------------------------
   98:	  007A			UPDATE_LEDS:
   99:	  007A	E5 31		    MOV     A, CURR_COUNT

