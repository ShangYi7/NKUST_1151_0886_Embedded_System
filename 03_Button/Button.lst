 Line  I  Addr  Code            Source

  100:	  007C	90 00 8C	    MOV     DPTR, #LED_TABLE
  101:	  007F	93		    MOVC    A, @A+DPTR
  102:	  0080	F5 A0		    MOV     P2, A             ; 將查表結果寫入 P2
  103:	  0082	22		    RET
  104:
  105:				; ------------------------------------------------------------------------------
  106:				; 軟體延遲子程式 (約 20ms, 12MHz 晶振)
  107:				; ------------------------------------------------------------------------------
  108:	  0083			DELAY_20MS:
  109:	  0083	7E 28		    MOV     R6, #40
  110:	  0085			D1:
  111:	  0085	7F FA		    MOV     R7, #250
  112:	  0087			D2:
  113:	  0087	DF FE		    DJNZ    R7, D2
  114:	  0089	DE FA		    DJNZ    R6, D1
  115:	  008B	22		    RET
  116:
  117:				; ------------------------------------------------------------------------------
  118:				; LED 輸出編碼查表 (低電位點亮: 0 為亮, 1 為滅)
  119:				; ------------------------------------------------------------------------------
  120:	  008C			LED_TABLE:
  121:	  008C	FF		    DB      0FFH    ; 0 顆亮 (全滅)
  122:	  008D	FE		    DB      0FEH    ; 1 顆亮 (P2.0 亮)
  123:	  008E	FC		    DB      0FCH    ; 2 顆亮 (P2.0~P2.1 亮)
  124:	  008F	F8		    DB      0F8H    ; 3 顆亮 (P2.0~P2.2 亮)
  125:	  0090	F0		    DB      0F0H    ; 4 顆亮 (P2.0~P2.3 亮)
  126:	  0091	E0		    DB      0E0H    ; 5 顆亮 (P2.0~P2.4 亮)
  127:	  0092	C0		    DB      0C0H    ; 6 顆亮 (P2.0~P2.5 亮)
  128:	  0093	80		    DB      080H    ; 7 顆亮 (P2.0~P2.6 亮)
  129:	  0094	00		    DB      000H    ; 8 顆亮 (全亮)
  130:
  131:				    END





