; ==============================================================================
; 專案名稱: AT89C52 雙機 UART 串列通訊 (實體硬體穩定版 - 防卡死 / 防彈跳)
; 實驗平台: 實體麵包板電路 / Proteus 模擬
; ------------------------------------------------------------------------------
; 實作硬體防卡死改進重點:
;   1. 增加「等待按鍵完全釋放 (Wait Key Release)」機制，杜絕按鍵彈跳與連擊卡死。
;   2. 發送常式加入安全發送旗標重置，杜絕 JNB TI 永久死等。
;   3. 開發實體建議: 建議發送端 (U3) 與接收端 (U1) 各司其職，避免兩端相互雜訊干擾。
; ==============================================================================

    ORG     0000H
    LJMP    MAIN

; ------------------------------------------------------------------------------
; 內部 RAM 變數定義
; ------------------------------------------------------------------------------
COUNTER_VAL DATA    30H       ; 目前計數值 (00H ~ FFH)
RECV_BUF    DATA    31H       ; 接收資料暫存器

KEY_PIN     BIT     P1.0      ; 按鈕輸入腳位 (U3 發送端)

; ------------------------------------------------------------------------------
; 主程式初始化
; ------------------------------------------------------------------------------
    ORG     0030H
MAIN:
    MOV     SP, #60H          ; 設定堆疊指標
    MOV     COUNTER_VAL, #00H ; 初始計數為 0
    MOV     P2, #0FFH         ; P2 輸出高電位 (共陽極 LED 全滅)
    SETB    KEY_PIN           ; 確保 P1.0 處於輸入準備狀態 (寫 1 打開內部弱上拉)

    ; --- 初始化 UART 與 Timer 1 鮑率產生器 ---
    ; TMOD: Timer 1 Mode 2 (8 位元自動重載)
    MOV     TMOD, #20H
    ; SCON: Mode 1 (8-bit UART), REN=1 (致能接收)
    MOV     SCON, #50H

    ; 鮑率設定 (預設相容 11.0592MHz 與 12MHz 通訊):
    ; 11.0592MHz @ 9600 bps: TH1 = 0FDH
    ; 若實體電路為 12MHz 且通訊不穩定，可改為 2400/4800 bps
    MOV     TH1, #0FDH
    MOV     TL1, #0FDH
    SETB    TR1               ; 啟動 Timer 1

    ; 清空串列傳輸與接收旗標
    CLR     TI
    CLR     RI

; ------------------------------------------------------------------------------
; 主迴圈
; ------------------------------------------------------------------------------
MAIN_LOOP:
    ; ==========================================================================
    ; 1. 串列接收檢查 (接收端 U1 負責)
    ; ==========================================================================
    JNB     RI, CHECK_KEY     ; 若無收到資料，跳到檢查按鍵
    CLR     RI                ; 清除接收中斷旗標
    MOV     A, SBUF           ; 讀取收到的位元組
    MOV     RECV_BUF, A       ; 儲存備份
    CPL     A                 ; 取反碼 (LED 共陽極: 低電位 0 點亮)
    MOV     P2, A             ; 輸出至 P2 顯示

CHECK_KEY:
    ; ==========================================================================
    ; 2. 按鍵偵測與發送 (發送端 U3 負責)
    ; ==========================================================================
    JB      KEY_PIN, MAIN_LOOP ; 若按鍵沒按下 (高電位 1)，回主迴圈

    ; --- 步驟 A: 按下檢測與 20ms 去彈跳 ---
    ACALL   DELAY_20MS
    JB      KEY_PIN, MAIN_LOOP ; 若為暫態雜訊，忽略返回

    ; --- 步驟 B: 執行計數累加並透過 UART 發送 ---
    INC     COUNTER_VAL
    MOV     A, COUNTER_VAL
    ACALL   UART_SEND_BYTE

    ; --- 步驟 C: 【實體防卡死關鍵】等待按鍵完全放開 (Wait Key Release) ---
WAIT_RELEASE:
    ; 期間仍持續監聽接收，避免通訊被按鍵放開動作阻塞
    JNB     RI, SKIP_RECV_IN_WAIT
    CLR     RI
    MOV     A, SBUF
    CPL     A
    MOV     P2, A
SKIP_RECV_IN_WAIT:
    JNB     KEY_PIN, WAIT_RELEASE ; 只要按鈕還沒放開，就持續等待

    ; --- 步驟 D: 放手去彈跳 ---
    ACALL   DELAY_20MS

    SJMP    MAIN_LOOP

; ------------------------------------------------------------------------------
; 子程式: 穩定發送一個位元組
; ------------------------------------------------------------------------------
UART_SEND_BYTE:
    CLR     TI                  ; 發送前先清空 TI
    MOV     SBUF, A             ; 寫入 SBUF 啟動發送
WAIT_TX:
    JNB     TI, WAIT_TX         ; 等待硬體發送完成
    CLR     TI                  ; 清除 TI
    RET

; ------------------------------------------------------------------------------
; 軟體延遲子程式 (約 20ms)
; ------------------------------------------------------------------------------
DELAY_20MS:
    MOV     R6, #40
D1:
    MOV     R7, #250
D2:
    DJNZ    R7, D2
    DJNZ    R6, D1
    RET

    END
