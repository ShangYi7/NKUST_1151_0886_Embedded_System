       MCS-51 Family Macro Assembler   A S E M - 5 1   V 1.3
       =====================================================



	Source File:	UART_RX.a51
	Object File:	UART_RX.hex
	List File:	UART_RX.lst



 Line  I  Addr  Code            Source

    1:				; ==============================================================================
    2:				; 專案名稱: AT89C52 雙機 UART 串列通訊 - 純接收端 (U1 Receiver)
    3:				; 腳位定義:
    4:				;   - 接收: P3.0 (RXD) 接自發送端 P3.1 (TXD)
    5:				;   - 輸出: P2.0 ~ P2.7 接至共陽極 LED Bar (低電位 0 點亮)
    6:				; ==============================================================================
    7:
    8:		N      0000	    ORG     0000H
    9:	  0000	02 00 30	    LJMP    MAIN
   10:
   11:		N	 30	RECV_BUF    DATA    30H
   12:
   13:		N      0030	    ORG     0030H
   14:	  0030			MAIN:
   15:	  0030	75 81 60	    MOV     SP, #60H
   16:	  0033	75 A0 FF	    MOV     P2, #0FFH           ; 初始 LED 全滅
   17:
   18:				    ; Timer 1 Mode 2 (8-bit 自動重載)
   19:	  0036	75 89 20	    MOV     TMOD, #20H
   20:	  0039	75 98 50	    MOV     SCON, #50H          ; Mode 1, REN=1 (致能接收)
   21:	  003C	75 8D FD	    MOV     TH1, #0FDH          ; 9600 bps @ 11.0592MHz (或 12MHz 同步)
   22:	  003F	75 8B FD	    MOV     TL1, #0FDH
   23:	  0042	D2 8E		    SETB    TR1
   24:	  0044	C2 98		    CLR     RI
   25:
   26:	  0046			MAIN_LOOP:
   27:	  0046	30 98 FD	    JNB     RI, MAIN_LOOP       ; 等待接收到資料
   28:	  0049	C2 98		    CLR     RI                  ; 清除接收中斷旗標
   29:	  004B	E5 99		    MOV     A, SBUF             ; 讀取 SBUF 資料
   30:	  004D	F5 30		    MOV     RECV_BUF, A
   31:	  004F	F4		    CPL     A                   ; 取反碼 (共陽極低電位亮)
   32:	  0050	F5 A0		    MOV     P2, A               ; 輸出至 LED 顯示
   33:	  0052	80 F2		    SJMP    MAIN_LOOP
   34:
   35:				    END





                     register banks used:  ---

                     no errors

