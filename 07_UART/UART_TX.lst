       MCS-51 Family Macro Assembler   A S E M - 5 1   V 1.3
       =====================================================



	Source File:	UART_TX.a51
	Object File:	UART_TX.hex
	List File:	UART_TX.lst



 Line  I  Addr  Code            Source

    1:				; ==============================================================================
    2:				; 專案名稱: AT89C52 雙機 UART 串列通訊 - 純發送端 (U3 Transmitter)
    3:				; 腳位定義:
    4:				;   - 按鈕: P1.0 (按下為低電位 0)
    5:				;   - 發送: P3.1 (TXD) 接至接收端 P3.0 (RXD)
    6:				; ==============================================================================
    7:
    8:		N      0000	    ORG     0000H
    9:	  0000	02 00 30	    LJMP    MAIN
   10:
   11:		N	 30	COUNTER_VAL DATA    30H
   12:		B	 90	KEY_PIN     BIT     P1.0
   13:
   14:		N      0030	    ORG     0030H
   15:	  0030			MAIN:
   16:	  0030	75 81 60	    MOV     SP, #60H
   17:	  0033	75 30 00	    MOV     COUNTER_VAL, #00H
   18:	  0036	D2 90		    SETB    KEY_PIN
   19:
   20:				    ; Timer 1 Mode 2 (8-bit 自動重載)
   21:	  0038	75 89 20	    MOV     TMOD, #20H
   22:	  003B	75 98 40	    MOV     SCON, #40H          ; Mode 1, REN=0 (純發送，不接收)
   23:	  003E	75 8D FD	    MOV     TH1, #0FDH          ; 9600 bps @ 11.0592MHz (或 12MHz 同步)
   24:	  0041	75 8B FD	    MOV     TL1, #0FDH
   25:	  0044	D2 8E		    SETB    TR1
   26:	  0046	C2 99		    CLR     TI
   27:
   28:	  0048			MAIN_LOOP:
   29:	  0048	20 90 FD	    JB      KEY_PIN, MAIN_LOOP  ; 未按下則等待
   30:
   31:	  004B	11 67		    ACALL   DELAY_20MS          ; 按下防彈跳
   32:	  004D	20 90 F8	    JB      KEY_PIN, MAIN_LOOP
   33:
   34:	  0050	05 30		    INC     COUNTER_VAL         ; 計數 +1
   35:	  0052	E5 30		    MOV     A, COUNTER_VAL
   36:	  0054	11 5D		    ACALL   UART_SEND_BYTE      ; 送出資料
   37:
   38:	  0056			WAIT_RELEASE:
   39:	  0056	30 90 FD	    JNB     KEY_PIN, WAIT_RELEASE ; 等待完全放開按鈕
   40:	  0059	11 67		    ACALL   DELAY_20MS          ; 放開防彈跳
   41:
   42:	  005B	80 EB		    SJMP    MAIN_LOOP
   43:

