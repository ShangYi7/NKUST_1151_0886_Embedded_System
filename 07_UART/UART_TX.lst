 Line  I  Addr  Code            Source

   44:	  005D			UART_SEND_BYTE:
   45:	  005D	C2 99		    CLR     TI
   46:	  005F	F5 99		    MOV     SBUF, A
   47:	  0061			WAIT_TX:
   48:	  0061	30 99 FD	    JNB     TI, WAIT_TX
   49:	  0064	C2 99		    CLR     TI
   50:	  0066	22		    RET
   51:
   52:	  0067			DELAY_20MS:
   53:	  0067	7E 28		    MOV     R6, #40
   54:	  0069			D1:
   55:	  0069	7F FA		    MOV     R7, #250
   56:	  006B			D2:
   57:	  006B	DF FE		    DJNZ    R7, D2
   58:	  006D	DE FA		    DJNZ    R6, D1
   59:	  006F	22		    RET
   60:
   61:				    END





