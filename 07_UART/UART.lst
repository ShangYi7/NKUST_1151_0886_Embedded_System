	Source File:	UART.a51
	Object File:	UART.hex
	List File:	UART.lst



 Line  I  Addr  Code            Source

    1:				; ==============================================================================
    2:				; 專案名稱: AT89C52 雙機 UART 串列通訊 (實體硬體穩定版 - 防卡死 / 防彈跳)
    3:				; 實驗平台: 實體麵包板電路 / Proteus 模擬
    4:				; ------------------------------------------------------------------------------
    5:				; 實作硬體防卡死改進重點:
    6:				;   1. 增加「等待按鍵完全釋放 (Wait Key Release)」機制，杜絕按鍵彈跳與連擊�
				�死。
    7:				;   2. 發送常式加入安全發送旗標重置，杜絕 JNB TI 永久死等。
    8:				;   3. 開發實體建議: 建議發送端 (U3) 與接收端 (U1) 各司其職，避免兩端相互�
				��訊干擾。
    9:				; ==============================================================================
   10:
   11:		N      0000	    ORG     0000H
   12:	  0000	02 00 30	    LJMP    MAIN
   13:
   14:				; ------------------------------------------------------------------------------
   15:				; 內部 RAM 變數定義
   16:				; ------------------------------------------------------------------------------
   17:		N	 30	COUNTER_VAL DATA    30H       ; 目前計數值 (00H ~ FFH)
   18:		N	 31	RECV_BUF    DATA    31H       ; 接收資料暫存器
   19:
   20:		B	 90	KEY_PIN     BIT     P1.0      ; 按鈕輸入腳位 (U3 發送端)
   21:
   22:				; ------------------------------------------------------------------------------
   23:				; 主程式初始化
   24:				; ------------------------------------------------------------------------------
   25:		N      0030	    ORG     0030H
   26:	  0030			MAIN:
   27:	  0030	75 81 60	    MOV     SP, #60H          ; 設定堆疊指標
   28:	  0033	75 30 00	    MOV     COUNTER_VAL, #00H ; 初始計數為 0
   29:	  0036	75 A0 FF	    MOV     P2, #0FFH         ; P2 輸出高電位 (共陽極 LED 全滅)
   30:	  0039	D2 90		    SETB    KEY_PIN           ; 確保 P1.0 處於輸入準備狀態 (寫 1 打開內部弱上拉)
   31:
   32:				    ; --- 初始化 UART 與 Timer 1 鮑率產生器 ---
   33:				    ; TMOD: Timer 1 Mode 2 (8 位元自動重載)
   34:	  003B	75 89 20	    MOV     TMOD, #20H
   35:				    ; SCON: Mode 1 (8-bit UART), REN=1 (致能接收)
   36:	  003E	75 98 50	    MOV     SCON, #50H
   37:
   38:				    ; 鮑率設定 (預設相容 11.0592MHz 與 12MHz 通訊):
   39:				    ; 11.0592MHz @ 9600 bps: TH1 = 0FDH
   40:				    ; 若實體電路為 12MHz 且通訊不穩定，可改為 2400/4800 bps
   41:	  0041	75 8D FD	    MOV     TH1, #0FDH

ASEM-51 V1.3                                         Copyright (c) 2002 by W.W. Heinz                                         PAGE 2



 Line  I  Addr  Code            Source

   42:	  0044	75 8B FD	    MOV     TL1, #0FDH
   43:	  0047	D2 8E		    SETB    TR1               ; 啟動 Timer 1
   44:
   45:				    ; 清空串列傳輸與接收旗標
   46:	  0049	C2 99		    CLR     TI
   47:	  004B	C2 98		    CLR     RI
   48:
   49:				; ------------------------------------------------------------------------------
   50:				; 主迴圈
   51:				; ------------------------------------------------------------------------------
   52:	  004D			MAIN_LOOP:
   53:				    ; ==========================================================================
   54:				    ; 1. 串列接收檢查 (接收端 U1 負責)
   55:				    ; ==========================================================================
   56:	  004D	30 98 09	    JNB     RI, CHECK_KEY     ; 若無收到資料，跳到檢查按鍵
   57:	  0050	C2 98		    CLR     RI                ; 清除接收中斷旗標
   58:	  0052	E5 99		    MOV     A, SBUF           ; 讀取收到的位元組
   59:	  0054	F5 31		    MOV     RECV_BUF, A       ; 儲存備份
   60:	  0056	F4		    CPL     A                 ; 取反碼 (LED 共陽極: 低電位 0 點亮)
   61:	  0057	F5 A0		    MOV     P2, A             ; 輸出至 P2 顯示
   62:
   63:	  0059			CHECK_KEY:
   64:				    ; ==========================================================================
   65:				    ; 2. 按鍵偵測與發送 (發送端 U3 負責)
   66:				    ; ==========================================================================
   67:	  0059	20 90 F1	    JB      KEY_PIN, MAIN_LOOP ; 若按鍵沒按下 (高電位 1)，回主迴圈
   68:
   69:				    ; --- 步驟 A: 按下檢測與 20ms 去彈跳 ---
   70:	  005C	11 82		    ACALL   DELAY_20MS
   71:	  005E	20 90 EC	    JB      KEY_PIN, MAIN_LOOP ; 若為暫態雜訊，忽略返回
   72:
   73:				    ; --- 步驟 B: 執行計數累加並透過 UART 發送 ---
   74:	  0061	05 30		    INC     COUNTER_VAL
   75:	  0063	E5 30		    MOV     A, COUNTER_VAL
   76:	  0065	11 78		    ACALL   UART_SEND_BYTE
   77:
   78:				    ; --- 步驟 C: 【實體防卡死關鍵】等待按鍵完全放開 (Wait Key Release) ---
   79:	  0067			WAIT_RELEASE:
   80:				    ; 期間仍持續監聽接收，避免通訊被按鍵放開動作阻塞
   81:	  0067	30 98 07	    JNB     RI, SKIP_RECV_IN_WAIT
   82:	  006A	C2 98		    CLR     RI
   83:	  006C	E5 99		    MOV     A, SBUF
   84:	  006E	F4		    CPL     A
   85:	  006F	F5 A0		    MOV     P2, A
   86:	  0071			SKIP_RECV_IN_WAIT:
   87:	  0071	30 90 F3	    JNB     KEY_PIN, WAIT_RELEASE ; 只要按鈕還沒放開，就持續等待
   88:
   89:				    ; --- 步驟 D: 放手去彈跳 ---
   90:	  0074	11 82		    ACALL   DELAY_20MS
   91:
   92:	  0076	80 D5		    SJMP    MAIN_LOOP
   93:
   94:				; ------------------------------------------------------------------------------
   95:				; 子程式: 穩定發送一個位元組
   96:				; ------------------------------------------------------------------------------
   97:	  0078			UART_SEND_BYTE:

ASEM-51 V1.3                                         Copyright (c) 2002 by W.W. Heinz                                         PAGE 3



 Line  I  Addr  Code            Source

   98:	  0078	C2 99		    CLR     TI                  ; 發送前先清空 TI
   99:	  007A	F5 99		    MOV     SBUF, A             ; 寫入 SBUF 啟動發送
  100:	  007C			WAIT_TX:
  101:	  007C	30 99 FD	    JNB     TI, WAIT_TX         ; 等待硬體發送完成
  102:	  007F	C2 99		    CLR     TI                  ; 清除 TI
  103:	  0081	22		    RET
  104:
  105:				; ------------------------------------------------------------------------------
  106:				; 軟體延遲子程式 (約 20ms)
  107:				; ------------------------------------------------------------------------------
  108:	  0082			DELAY_20MS:
  109:	  0082	7E 28		    MOV     R6, #40
  110:	  0084			D1:
  111:	  0084	7F FA		    MOV     R7, #250
  112:	  0086			D2:
  113:	  0086	DF FE		    DJNZ    R7, D2
  114:	  0088	DE FA		    DJNZ    R6, D1
  115:	  008A	22		    RET
  116:
  117:				    END





