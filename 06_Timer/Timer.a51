; ==============================================================================
; 專案名稱: AT89S52 按鍵多功能控制 8-LED 疊加與長按連發 (P2 輸出)
; 腳位定義:
;   - 按鈕: P3.2 (低電位按下)
;   - LED:  P2.0 ~ P2.7 (低電位點亮, 0 = 亮, 1 = 滅)
; 邏輯說明:
;   - BASE_COUNT: 目前恆亮的燈數 (0 ~ 7)
;   - CURR_COUNT: 當前顯示的總亮燈數 (BASE_COUNT ~ 8)
;   - 短按: 亮燈數 +1
;   - 長按 (超過約 0.6 秒): 每 200ms 自動連發 +1
; ==============================================================================

    ORG     0000H
    LJMP    MAIN

; ------------------------------------------------------------------------------
; 變數定義 (內部 RAM 位址)
; ------------------------------------------------------------------------------
BASE_COUNT  DATA    30H       ; 恆亮基底燈數 (0 ~ 7)
CURR_COUNT  DATA    31H       ; 目前亮燈總數 (0 ~ 8)
HOLD_TIMER  DATA    32H       ; 長按累積計時器

KEY_PIN     BIT     P3.2      ; 按鍵腳位

; ------------------------------------------------------------------------------
; 主程式初始化
; ------------------------------------------------------------------------------
    ORG     0030H
MAIN:
    MOV     SP, #60H          ; 設定堆疊指標
    MOV     BASE_COUNT, #00H  ; 初始基底: 0 顆恆亮
    MOV     CURR_COUNT, #00H  ; 初始總亮燈: 0 顆
    ACALL   UPDATE_LEDS       ; 刷新 LED (P2 全部熄滅)

; ------------------------------------------------------------------------------
; 主迴圈: 輪詢按鍵
; ------------------------------------------------------------------------------
MAIN_LOOP:
    JB      KEY_PIN, MAIN_LOOP ; 若沒按下 (高電位 1), 繼續等待

    ; 1. 檢測到按下, 執行去彈跳
    ACALL   DELAY_20MS
    JB      KEY_PIN, MAIN_LOOP ; 若是彈跳雜訊, 忽略

    ; 2. 確定短按觸發: 立即增加一顆 LED
    ACALL   INC_LED_STEP
    ACALL   UPDATE_LEDS

    ; 3. 進入長按判定階段 (延遲約 0.6 秒)
    MOV     HOLD_TIMER, #30    ; 30 * 20ms = 600ms
WAIT_HOLD:
    ACALL   DELAY_20MS
    JB      KEY_PIN, MAIN_LOOP ; 若在 600ms 內放開, 視為單純短按, 回主迴圈
    DJNZ    HOLD_TIMER, WAIT_HOLD

    ; 4. 長按連發迴圈 (Auto-repeat): 只要沒放開, 每 200ms 增加一顆
AUTO_REPEAT_LOOP:
    ACALL   INC_LED_STEP
    ACALL   UPDATE_LEDS

    ; 延遲 200ms (切分成 10 次 20ms, 隨時監控放開)
    MOV     R5, #10
REPEAT_DELAY:
    ACALL   DELAY_20MS
    JB      KEY_PIN, MAIN_LOOP ; 若途中放開按鈕, 立即退出連發
    DJNZ    R5, REPEAT_DELAY

    SJMP    AUTO_REPEAT_LOOP

; ------------------------------------------------------------------------------
; 子程式: 增加一顆 LED 並處理「進位 / 恆亮底數」邏輯
; ------------------------------------------------------------------------------
INC_LED_STEP:
    INC     CURR_COUNT
    MOV     A, CURR_COUNT
    CJNE    A, #9, INC_DONE    ; 若總數還沒達到 9 (0~8), 正常結束

    ; 當 8 個燈滿了之後, 下一次觸發進位:
    INC     BASE_COUNT
    MOV     A, BASE_COUNT
    CJNE    A, #8, SET_NEW_BASE

    ; 若 8 個燈都變成恆亮, 全部輪空重置 (回第 1 輪)
    MOV     BASE_COUNT, #00H
    MOV     CURR_COUNT, #00H
    RET

SET_NEW_BASE:
    ; 下一輪開始: 新的總亮燈數直接從新的基底開始
    MOV     CURR_COUNT, BASE_COUNT

INC_DONE:
    RET

; ------------------------------------------------------------------------------
; 子程式: 依 CURR_COUNT 更新 P2 輸出 (低電位點亮)
; ------------------------------------------------------------------------------
UPDATE_LEDS:
    MOV     A, CURR_COUNT
    MOV     DPTR, #LED_TABLE
    MOVC    A, @A+DPTR
    MOV     P2, A             ; 將查表結果寫入 P2
    RET

; ------------------------------------------------------------------------------
; 軟體延遲子程式 (約 20ms, 12MHz 晶振)
; ------------------------------------------------------------------------------
DELAY_20MS:
    MOV     R6, #40
D1:
    MOV     R7, #250
D2:
    DJNZ    R7, D2
    DJNZ    R6, D1
    RET

; ------------------------------------------------------------------------------
; LED 輸出編碼查表 (低電位點亮: 0 為亮, 1 為滅)
; ------------------------------------------------------------------------------
LED_TABLE:
    DB      0FFH    ; 0 顆亮 (全滅)
    DB      0FEH    ; 1 顆亮 (P2.0 亮)
    DB      0FCH    ; 2 顆亮 (P2.0~P2.1 亮)
    DB      0F8H    ; 3 顆亮 (P2.0~P2.2 亮)
    DB      0F0H    ; 4 顆亮 (P2.0~P2.3 亮)
    DB      0E0H    ; 5 顆亮 (P2.0~P2.4 亮)
    DB      0C0H    ; 6 顆亮 (P2.0~P2.5 亮)
    DB      080H    ; 7 顆亮 (P2.0~P2.6 亮)
    DB      000H    ; 8 顆亮 (全亮)

    END