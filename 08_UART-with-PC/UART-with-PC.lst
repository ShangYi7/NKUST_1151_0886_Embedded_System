 Line  I  Addr  Code            Source

  100:
  101:	  0064	80 EA		    SJMP    MAIN_LOOP
  102:
  103:				; ------------------------------------------------------------------------------
  104:				; 暫停模式處理: 專注監聽 PC 端指令
  105:				; ------------------------------------------------------------------------------
  106:	  0066			PAUSE_PROCESS:
  107:	  0066	30 98 FD	    JNB     RI, PAUSE_PROCESS ; 等待 PC 端傳送字元
  108:	  0069	11 7C		    ACALL   PROCESS_UART_CHAR ; 處理接收到的指令
  109:	  006B	80 E3		    SJMP    MAIN_LOOP
  110:
  111:				; ------------------------------------------------------------------------------
  112:				; 子程式: 步進延遲 (約 600ms) 並即時輪詢 UART 接收
  113:				; 設計說明:
  114:				;   將 600ms 拆解為 30 個 20ms 區間，每 20ms 檢查一次 RI 旗標。
  115:				;   若有鍵盤輸入則立即處理，大幅提升系統反應即時性。
  116:				; ------------------------------------------------------------------------------
  117:	  006D			DELAY_WITH_UART_POLL:
  118:	  006D	7C 1E		    MOV     R4, #30           ; 30 * 20ms = 600ms
  119:	  006F			D_LOOP:
  120:	  006F	31 5C		    ACALL   DELAY_20MS
  121:
  122:				    ; 檢查是否有 PC 端傳來的字元
  123:	  0071	30 98 05	    JNB     RI, D_NO_CHAR
  124:	  0074	11 7C		    ACALL   PROCESS_UART_CHAR
  125:				    ; 若收到指令後變為暫停狀態，立即結束延遲
  126:	  0076	20 00 02	    JB      PAUSE_FLAG, D_EXIT
  127:
  128:	  0079			D_NO_CHAR:
  129:	  0079	DC F4		    DJNZ    R4, D_LOOP
  130:	  007B			D_EXIT:
  131:	  007B	22		    RET
  132:
  133:				; ------------------------------------------------------------------------------
  134:				; 子程式: 處理 UART 接收字元 (PC 鍵盤指令解析)
  135:				; ------------------------------------------------------------------------------
  136:	  007C			PROCESS_UART_CHAR:
  137:	  007C	C2 98		    CLR     RI                ; 清除接收中斷旗標
  138:	  007E	E5 99		    MOV     A, SBUF           ; 讀取收到的 ASCII 字元
  139:
  140:				    ; 忽略換行與回車符號
  141:	  0080	B4 0D 01	    CJNE    A, #0DH, CHK_LF
  142:	  0083	22		    RET
  143:	  0084			CHK_LF:
  144:	  0084	B4 0A 01	    CJNE    A, #0AH, CHK_DIGIT
  145:	  0087	22		    RET
  146:
  147:				; --- 1. 檢查是否為 '0' ~ '9' ---
  148:	  0088			CHK_DIGIT:
  149:	  0088	B4 30 02	    CJNE    A, #'0', CHK_D_GT
  150:	  008B	80 07		    SJMP    SET_DIGIT
  151:	  008D			CHK_D_GT:
  152:	  008D	40 54		    JC      CHK_PLUS          ; 小於 '0'，跳去檢查符號
  153:	  008F	B4 3A 00	    CJNE    A, #('9' + 1), CHK_D_VALID
  154:	  0092			CHK_D_VALID:
  155:	  0092	50 07		    JNC     CHK_UPPER         ; 大於 '9'，跳去檢查大寫字母

