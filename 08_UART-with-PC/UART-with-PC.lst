 Line  I  Addr  Code            Source

  156:	  0094			SET_DIGIT:
  157:	  0094	C3		    CLR     C
  158:	  0095	94 30		    SUBB    A, #'0'           ; 轉換為數值 0 ~ 9
  159:	  0097	F5 30		    MOV     COUNTER_VAL, A
  160:	  0099	80 78		    SJMP    CMD_UPDATE_COUNT
  161:
  162:				; --- 2. 檢查是否為大寫 'A' ~ 'F' ---
  163:	  009B			CHK_UPPER:
  164:	  009B	B4 41 02	    CJNE    A, #'A', CHK_U_GT
  165:	  009E	80 07		    SJMP    SET_UPPER
  166:	  00A0			CHK_U_GT:
  167:	  00A0	40 0E		    JC      CHK_LOWER         ; 小於 'A'，跳去檢查小寫字母
  168:	  00A2	B4 47 00	    CJNE    A, #('F' + 1), CHK_U_VALID
  169:	  00A5			CHK_U_VALID:
  170:	  00A5	50 09		    JNC     CHK_LOWER         ; 大於 'F'，跳去檢查小寫字母
  171:	  00A7			SET_UPPER:
  172:	  00A7	C3		    CLR     C
  173:	  00A8	94 41		    SUBB    A, #'A'
  174:	  00AA	24 0A		    ADD     A, #10            ; 轉換為數值 10 ~ 15 (0AH ~ 0FH)
  175:	  00AC	F5 30		    MOV     COUNTER_VAL, A
  176:	  00AE	80 63		    SJMP    CMD_UPDATE_COUNT
  177:
  178:				; --- 3. 檢查是否為小寫 'a' ~ 'f' ---
  179:	  00B0			CHK_LOWER:
  180:	  00B0	B4 61 02	    CJNE    A, #'a', CHK_L_GT
  181:	  00B3	80 07		    SJMP    SET_LOWER
  182:	  00B5			CHK_L_GT:
  183:	  00B5	40 0E		    JC      CHK_SPACE         ; 小於 'a'，跳去檢查空白鍵
  184:	  00B7	B4 67 00	    CJNE    A, #('f' + 1), CHK_L_VALID
  185:	  00BA			CHK_L_VALID:
  186:	  00BA	50 09		    JNC     CHK_SPACE         ; 大於 'f'，跳去檢查其他指令
  187:	  00BC			SET_LOWER:
  188:	  00BC	C3		    CLR     C
  189:	  00BD	94 61		    SUBB    A, #'a'
  190:	  00BF	24 0A		    ADD     A, #10            ; 轉換為數值 10 ~ 15 (0AH ~ 0FH)
  191:	  00C1	F5 30		    MOV     COUNTER_VAL, A
  192:	  00C3	80 4E		    SJMP    CMD_UPDATE_COUNT
  193:
  194:				; --- 4. 檢查是否為空白鍵 ' ' 或 'P' / 'p' (暫停/恢復切換) ---
  195:	  00C5			CHK_SPACE:
  196:	  00C5	B4 20 02	    CJNE    A, #' ', CHK_KEY_P
  197:	  00C8	80 08		    SJMP    TOGGLE_PAUSE
  198:	  00CA			CHK_KEY_P:
  199:	  00CA	B4 50 02	    CJNE    A, #'P', CHK_KEY_P_LOW
  200:	  00CD	80 03		    SJMP    TOGGLE_PAUSE
  201:	  00CF			CHK_KEY_P_LOW:
  202:	  00CF	B4 70 11	    CJNE    A, #'p', CHK_PLUS
  203:	  00D2			TOGGLE_PAUSE:
  204:	  00D2	B2 00		    CPL     PAUSE_FLAG        ; 切換暫停 / 運行狀態
  205:	  00D4	20 00 06	    JB      PAUSE_FLAG, SEND_PAUSE_NOTIFY
  206:				    ; 發送恢復運行通知
  207:	  00D7	90 02 FF	    MOV     DPTR, #STR_RESUME
  208:	  00DA	31 48		    ACALL   SEND_STRING
  209:	  00DC	22		    RET
  210:	  00DD			SEND_PAUSE_NOTIFY:
  211:	  00DD	90 02 E4	    MOV     DPTR, #STR_PAUSE

